# 实验探针（experiments/）只留源码：
#   sdk/     = 解包出来的 WebView2 SDK（与 third_party/webview2 重复，20M+）
#   wv2data/ = WebView2 运行时缓存（浏览器 profile，会自己长）
#   *.nupkg / *.o / 复制进来的 Loader.dll = 下载与编译中间产物
experiments/*/sdk/
experiments/*/wv2data/
experiments/*/*.nupkg
experiments/*/*.o
experiments/*/WebView2Loader.dll

# 历史备份（重建成 v0.1 之前的完整 git bundle）
.git-backup/
